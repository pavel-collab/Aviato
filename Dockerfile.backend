# Образ для FastAPI backend и worker-а AviaTrade.
#
# В отличие от Dockerfile (LangGraph Server), здесь нужен сам пакет ``aviatrade``
# целиком: backend/worker импортируют исполнительный слой приложения
# (cli.lib / db / scraper). Поэтому ставим проект через uv и кладём Chromium —
# worker делает реальный браузерный скрапинг Aviasales.

FROM python:3.12-slim

# uv — менеджер окружения (как в основном проекте).
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Chromium + драйвер для botasaurus/Selenium-скрапинга внутри контейнера.
RUN apt-get update && apt-get install -y --no-install-recommends \
        chromium chromium-driver \
    && rm -rf /var/lib/apt/lists/*

ENV UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

# Сначала только метаданные — кешируем слой установки зависимостей.
COPY pyproject.toml README.md ./
COPY src ./src
RUN uv sync --extra backend

# По умолчанию запускаем backend; сервис worker переопределяет command в compose.
EXPOSE 8000
CMD ["uvicorn", "aviatrade.backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
