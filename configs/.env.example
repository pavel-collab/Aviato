# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flight_prices
DB_USER=flight_user
DB_PASSWORD=flight_password

# OpenRouter API configuration
OPENROUTER_API_KEY=...

# Model name for AI agent
# IMPORTANT: Use models that support tool calling (function calling)
# Recommended models with tool calling support:
#   - openai/gpt-4o-mini (paid, reliable tool calling)
#   - openai/gpt-4o (paid, best tool calling)
#   - anthropic/claude-3.5-sonnet (paid, excellent tool calling)
#   - google/gemini-1.5-flash (paid, good tool calling)
# Free models often DON'T support tool calling and will only describe tools
# instead of actually calling them:
#   - openai/gpt-oss-120b:free (NO tool calling support)
#   - google/gemini-2.0-flash-exp:free (limited tool calling)
MODEL_NAME=openai/gpt-4o-mini

# --- LangGraph / LangSmith (опционально) -------------------------------------
# Запуск графа локально:    uv run langgraph dev   (LangGraph Studio)
# Прод-деплой:              docker-compose up -d --build  (сервис langgraph-server)
#
# LangSmith включает трассировку каждого шага графа (router → субагент →
# инструмент). Переменные читаются и langgraph dev, и langgraph-server.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=aviatrade

# --- FastAPI backend (опционально) -------------------------------------------
# Внешний REST API + worker. Локальный запуск (без Docker):
#   uv run --extra backend uvicorn aviatrade.backend.main:app --reload
#   uv run --extra backend python -m aviatrade.backend.worker
# Дефолты в config.py указывают на имена docker-сервисов; для локали — localhost.
LANGGRAPH_URL=http://localhost:8123
GRAPH_ID=aviatrade_agent
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
REDIS_URL=redis://localhost:6379/1
JOB_QUEUE=aviatrade_jobs
