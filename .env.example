# Шаблон корневого .env (скопируй в .env; .env в .gitignore).
#
# Здесь ТОЛЬКО переменные, которые читаются сторонними SDK напрямую из окружения
# процесса, а не нашим кодом. Прикладной конфиг (БД/LLM/RabbitMQ/Redis) живёт
# исключительно в config*.yaml каждого сервиса (схема YAML-only, env игнорируется).
#
# Кто использует этот файл:
#   - docker compose: подставляет ${LANGSMITH_*} в сервис `agent`;
#   - `langgraph dev`: грузит его через "env" в projects/agent/langgraph.json.
#
# Трейсинг агента идёт в процессе LangGraph Server (сервис `agent`), который
# изолирует каждый run через contextvars — гонок между параллельными запусками нет.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...        # ключ из https://smith.langchain.com (Settings → API Keys)
LANGSMITH_PROJECT=aviatrade
