# LangSmith / трейсинг агента.
# Читаются НЕ нашим кодом, а SDK langsmith/langgraph напрямую из окружения процесса:
#   - docker compose подставляет их в сервис `agent` (см. docker-compose.yml);
#   - `langgraph dev` подхватывает этот файл через "env" в projects/agent/langgraph.json.
# Прикладной конфиг (БД/LLM/...) сюда НЕ кладём — он только в config*.yaml (YAML-only).
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=aviatrade
